# Build-time configuration for the site.
#
# Both values are optional. Defaults work for a user-page deploy
# at https://<user>.github.io/. Override them in CI when deploying
# this project to a repository (project-page) URL such as
# https://<user>.github.io/<repo>/.

# Absolute origin used in canonical URLs, OG/Twitter tags and JSON-LD.
NEXT_PUBLIC_SITE_URL="https://zszanto.github.io"

# Sub-path the site is served from. Leave empty for a user-page deploy,
# set to "/<repo>" (no trailing slash) for a project-page deploy.
NEXT_PUBLIC_BASE_PATH=""
